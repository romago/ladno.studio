{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ladno-studio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ladno.studio", "custom_domain": true },
    { "pattern": "www.ladno.studio", "custom_domain": true }
  ],
  "workers_dev": false
}
